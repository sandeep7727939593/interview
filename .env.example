# ─── Environment variables ───────────────────────────────────────
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local

# MongoDB connection string.
# Local Mongo:    mongodb://127.0.0.1:27017/interview
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interview
MONGODB_URI=

# Password for the admin login (used to add / edit / delete questions).
ADMIN_PASSWORD=

# ─── AI (Ask-AI search + CV analyzer) ────────────────────────────
# Provider is auto-detected from the key prefix:
#   "gsk_…" → Groq    (https://console.groq.com)   default model: llama-3.3-70b-versatile
#   "xai-…" → xAI Grok (https://console.x.ai)       default model: grok-3
# Leave empty to disable the AI features gracefully. NEVER put a real key here.
GROK_API_KEY=
# Optional overrides:
# AI_MODEL=
# AI_BASE_URL=
